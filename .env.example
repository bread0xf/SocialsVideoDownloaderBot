# Copy to .env for local development. Never commit .env or real secrets.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
# API listen port. Hosted platforms may inject PORT.
PORT=8000

# PostgreSQL (compose service values)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=socialsvideodownloaderbot
# postgres:// and postgresql:// URLs are normalised to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:dev-only-change-me@localhost:5432/socialsvideodownloaderbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true
# TELEGRAM_WEBHOOK_SECRET=

# Standalone v0 bot (no PostgreSQL, Redis or worker; in-memory usage only)
# Dedicated token for the v0 bot. Falls back to TELEGRAM_BOT_TOKEN when empty.
TELEGRAM_V0_BOT_TOKEN=
# Comma-separated Telegram user IDs that may use the v0 bot. Empty means everyone.
V0_ALLOWED_USER_IDS=
V0_MEDIA_ROOT=./storage/v0
# Falls back to FREE_DAILY_LIMIT when empty.
V0_DAILY_LIMIT=
V0_MAX_ACTIVE_JOBS_PER_USER=1

# Entitlements (locked unless noted)
QUOTA_TIMEZONE=Africa/Lagos
FREE_DAILY_LIMIT=5
FREE_MAX_RESOLUTION_P=480
PREMIUM_MAX_RESOLUTION_P=2160
# Owner-approved 2026-11-06 (OD-02).
PREMIUM_DAILY_LIMIT=20

# Storage and retention
MEDIA_ROOT=./storage
MEDIA_CACHE_MAX_BYTES=53687091200
MEDIA_RETENTION_HOURS=24
PROCESSING_VERSION=1

# Resource and delivery limits (owner-approved 2026-11-06)
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_AGE_SECONDS=7200
MAX_MEDIA_BYTES=50331648
MAX_MEDIA_DURATION_SECONDS=600
# Tier-specific enforcement (free 1, Premium 2) is pending; global fallback is 2.
MAX_ACTIVE_JOBS_PER_USER=2
WORKER_CONCURRENCY=2
# Verify the current hosted Bot API limit before production launch (OD-07).
# Local Bot API server (--local) supports up to 2000 MB for Premium 4K.
TELEGRAM_UPLOAD_MAX_BYTES=52428800

# Extractor, processing and delivery timeouts
EXTRACTOR_METADATA_TIMEOUT_SECONDS=60
EXTRACTOR_DOWNLOAD_TIMEOUT_SECONDS=900
FFMPEG_TIMEOUT_SECONDS=600
DOWNLOAD_MAX_ATTEMPTS=3
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=10
CACHE_CLEANUP_INTERVAL_SECONDS=900
